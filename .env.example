# ── Infrastructure (REQUIRED) ────────────────────────
# Placeholder-only local development template. Replace values via a local
# untracked `.env` or the Enclii/Vault secret path for shared environments.
# Do not commit provider keys, worker tokens, org configs, customer data,
# prompts, social account credentials, webhooks, or GitHub tokens.

DATABASE_URL=replace-with-local-or-secret-store-database-url  # REQUIRED
# OPTIONAL — Database pool tuning (defaults are usually fine)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=30
REDIS_URL=redis://localhost:6379  # REQUIRED
ENVIRONMENT=development  # OPTIONAL (default: production)

# ── Security ───────────────────────────────────────
DEV_AUTH_BYPASS=false  # OPTIONAL (default: false; only enable in development)
RATE_LIMIT_PER_MINUTE=60  # OPTIONAL (default: 60)
# Per-client inbound message guards on long-lived WebSocket connections
# (events stream + approvals stream).
# EVENTS_WS_RATE_LIMIT=30
# EVENTS_WS_RATE_WINDOW_SECONDS=60.0
# APPROVALS_WS_RATE_LIMIT=30
# APPROVALS_WS_RATE_WINDOW_SECONDS=60.0
# How many recent DLQ entries the /api/v1/health/dlq-stats endpoint
# returns. Bump for ops dashboards that want a deeper history.
# DLQ_RECENT_LIMIT=10
# HMAC signing secret for consent_ledger row digests (legal-compliance audit
# trail for outbound voice-mode selection — LFPDPPP, GDPR, CASL, SB-1001).
# Empty here means the dev-default sentinel is used (rejected in production
# by Settings._validate_config). Generate with: openssl rand -hex 32
CONSENT_LEDGER_SIGNING_SECRET=replace-with-consent-ledger-signing-secret  # REQUIRED in production

# ── Auth (Janua OIDC) ──────────────────────────────
JANUA_ISSUER_URL=  # Set to your Janua instance URL (e.g., https://auth.example.com)
JANUA_CLIENT_ID=replace-with-janua-client-id  # OPTIONAL (default: selva-office)
JANUA_CLIENT_SECRET=replace-with-janua-client-secret  # OPTIONAL (required for production auth)
JANUA_JWT_SECRET=replace-with-janua-jwt-secret  # OPTIONAL (required for production auth)
NEXT_PUBLIC_JANUA_ISSUER_URL=  # Set to same as JANUA_ISSUER_URL
NEXT_PUBLIC_JANUA_CLIENT_ID=replace-with-public-janua-client-id  # OPTIONAL (frontend)

# ── Billing (Dhanam) ───────────────────────────────
DHANAM_API_URL=  # Set to your Dhanam instance URL
DHANAM_API_TOKEN=  # OPTIONAL (required for Dhanam billing/transaction API)
DHANAM_WEBHOOK_SECRET=replace-with-dhanam-webhook-secret  # OPTIONAL (required for billing webhooks)
NEXT_PUBLIC_DHANAM_URL=  # Set to same as DHANAM_API_URL

# ── Workers ────────────────────────────────────────
# Workers use DATABASE_URL directly (same DB as nexus-api)
WORKER_API_TOKEN=replace-with-worker-api-token  # OPTIONAL (default: dev-bypass; set to real JWT in production)
APPROVAL_TIMEOUT=300  # OPTIONAL (default: 300 seconds)

# ── Phynd-CRM Integration ──────────────────────────
PHYND_CRM_URL=http://localhost:3000  # OPTIONAL (required for CRM graph)
PHYND_CRM_TOKEN=  # OPTIONAL (required for CRM graph)

# ── Karafiel Compliance ───────────────────────────────
KARAFIEL_API_URL=http://localhost:3050  # OPTIONAL (required for compliance tools)
KARAFIEL_API_TOKEN=  # OPTIONAL (required for compliance tools)

# ── Tezca Legal Intelligence ─────────────────────────
TEZCA_API_URL=http://localhost:3040  # OPTIONAL (required for legal tools)
TEZCA_API_TOKEN=  # OPTIONAL (required for legal tools)

# ── MADFAM Crawler (web scraping service) ────────────
CRAWLER_API_URL=http://localhost:3070  # OPTIONAL (required for DOF monitoring)
CRAWLER_API_TOKEN=  # OPTIONAL (required for crawler auth)

# ── AI Inference (OPTIONAL — at least one needed for LLM inference) ──
ANTHROPIC_API_KEY=replace-with-anthropic-api-key  # OPTIONAL (enables Anthropic models)
OPENAI_API_KEY=replace-with-openai-api-key  # OPTIONAL (enables OpenAI models)
OPENROUTER_API_KEY=  # OPTIONAL (enables OpenRouter models)
TOGETHER_API_KEY=  # OPTIONAL (enables Together AI models)
FIREWORKS_API_KEY=  # OPTIONAL (enables Fireworks AI models)
DEEPINFRA_API_KEY=  # OPTIONAL (enables DeepInfra models)
SILICONFLOW_API_KEY=  # OPTIONAL (enables SiliconFlow GLM-5)
MOONSHOT_API_KEY=  # OPTIONAL (enables Moonshot Kimi K2.5)
GROQ_API_KEY=  # OPTIONAL (enables Groq models)
MISTRAL_API_KEY=  # OPTIONAL (enables Mistral models)
OLLAMA_BASE_URL=http://localhost:11434  # OPTIONAL (default: http://localhost:11434)
ORG_CONFIG_PATH=~/.selva/org-config.yaml  # OPTIONAL (org-level routing config)

# ── Search ─────────────────────────────────────────
SEARCH_API_KEY=  # OPTIONAL (required for research graph web search)
SEARCH_PROVIDER=tavily  # OPTIONAL (default: tavily)
REPO_BASE_PATH=~/.selva/repos  # OPTIONAL (default: ~/.selva/repos)

# ── GitHub / Deployment ───────────────────────────
GITHUB_TOKEN=replace-with-github-token  # OPTIONAL (required for git push and PR creation)
# Coupler Agent Tool Plane (delegated SaaS — preferred over direct SaaS tokens)
SELVA_COUPLER_TOOLS_ENABLED=false  # Set true to register coupler.* proxy tools in ToolRegistry
COUPLER_BASE_URL=http://localhost:8787  # Coupler gateway (staging: https://coupler-api.madfam.io)
COUPLER_AUDIENCE=coupler-api
GITHUB_REPOS=  # OPTIONAL (gateway polling)
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret  # OPTIONAL (required for GitHub webhook verification)
ENCLII_WEBHOOK_SECRET=  # OPTIONAL (required for Enclii webhook verification)
ENCLII_API_URL=  # OPTIONAL (required for deployment graph)
ENCLII_DEPLOY_TOKEN=  # OPTIONAL (required for deployment graph)

# ── OpenClaw Gateway ───────────────────────────────
OPENCLAW_API_KEY=  # OPTIONAL
OPENCLAW_MEMORY_DIR=./data/memory  # OPTIONAL
GATEWAY_PORT=4304  # OPTIONAL (default: 4304)
GATEWAY_TENANT_ORG_ID=madfam  # OPTIONAL (fallback tenant for gateway auto-dispatch service-token calls)

# ── Colyseus ────────────────────────────────────────
COLYSEUS_SECRET=replace-with-colyseus-secret  # OPTIONAL (change in production!)
COLYSEUS_SERVICE_TOKEN=  # OPTIONAL
COLYSEUS_TENANT_ORG_ID=madfam  # OPTIONAL (fallback tenant for Colyseus service-token API reads)

# ── WebRTC TURN Server (optional, required for corporate NAT traversal) ──
NEXT_PUBLIC_TURN_URL=turn:localhost:3478
NEXT_PUBLIC_TURN_USERNAME=replace-with-turn-username
NEXT_PUBLIC_TURN_CREDENTIAL=replace-with-turn-credential

# ── LiveKit SFU (optional, auto-activates when player count > threshold) ──
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
LIVEKIT_THRESHOLD=5

# ── Ports ───────────────────────────────────────────
NEXUS_API_PORT=4300  # OPTIONAL (default: 4300)
OFFICE_UI_PORT=4301  # OPTIONAL (default: 4301)
ADMIN_PORT=4302  # OPTIONAL (default: 4302)
COLYSEUS_PORT=4303  # OPTIONAL (default: 4303)
GATEWAY_HEALTH_PORT=4304  # OPTIONAL (default: 4304; gateway health/metrics HTTP server)

# ── Internal Service URLs ──────────────────────────
NEXUS_API_URL=http://localhost:4300  # OPTIONAL (used by Colyseus, gateway, workers)
NEXUS_API_WS_URL=ws://localhost:4300/api/v1/approvals/ws  # OPTIONAL (gateway WebSocket)

# ── Frontend ───────────────────────────────────────
NEXT_PUBLIC_GITHUB_REPOS=  # OPTIONAL
NEXT_PUBLIC_APP_URL=https://app.selva.town  # OPTIONAL (landing page links)
NEXT_PUBLIC_API_URL=http://localhost:4300  # OPTIONAL (default: http://localhost:4300)
NEXT_PUBLIC_COLYSEUS_URL=ws://localhost:4303  # OPTIONAL (default: ws://localhost:4303)
NEXT_PUBLIC_APPROVALS_WS_URL=ws://localhost:4300/api/v1/approvals/ws  # OPTIONAL
NEXT_PUBLIC_EVENTS_WS_URL=ws://localhost:4300/api/v1/events/ws  # OPTIONAL

# ── Guest Access ──────────────────────────────────
NEXT_PUBLIC_GUEST_ACCESS_ENABLED=true  # OPTIONAL (default: true; set false to disable guest join)
# NEXT_PUBLIC_GUEST_DEFAULT_ORG=  # OPTIONAL (org_id for invite-less guest joins)

# ── Demo Mode ────────────────────────────────────
NEXT_PUBLIC_DEMO_ENABLED=true  # OPTIONAL (default: true; set false to hide "Try Demo" CTA)

# ── CSP / Security Headers ───────────────────────
# CSP_EXTRA_SOURCES=  # OPTIONAL (extra connect-src origins, space-separated)

# ── OpenTelemetry (Phase 0 — optional until operator provisions secrets) ──
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instance_id:token)>
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# TEMPO_QUERY_URL=        # Optional read-only Tempo query base URL before /api for scripts/verify-observability-trace.sh
# TEMPO_QUERY_AUTH_HEADER= # Optional full auth header, e.g. Authorization=Bearer <token>
# GRAFANA_URL=            # Optional Grafana stack URL for datasource proxy trace verification
# GRAFANA_TEMPO_DATASOURCE_UID= # Optional Tempo datasource UID for Grafana proxy trace verification
# GRAFANA_API_TOKEN=      # Optional read-only Grafana service-account token for trace verification

# ── Sentry (Phase 0 — one DSN per service in k8s; local dev uses SENTRY_DSN) ──
# SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_DSN=  # office-ui / admin client-side
# SENTRY_AUTH_TOKEN=       # CI source-map upload only
# SENTRY_ORG=              # CI source-map upload only
# SENTRY_OFFICE_UI_PROJECT=selva-office-ui

# ── WhatsApp Business ─────────────────────────────
WHATSAPP_ACCESS_TOKEN=  # Meta Business API access token
WHATSAPP_PHONE_NUMBER_ID=  # WhatsApp Business phone number ID

# ── Skills ────────────────────────────────────────
SELVA_COMMUNITY_SKILLS_ENABLED=false  # OPTIONAL (default: false)

# ── Private npm Registry ──────────────────────────
NPM_REGISTRY_TOKEN=  # OPTIONAL (required for private npm registry)

# === Audience filter / autonomous pipeline / production hardening ===
# Platform vs tenant tool boundary (set to MADFAM org_id; unset = everyone is tenant)
PLATFORM_ORG_ID=
# Audience filter — start in shadow mode (false), flip true after 24-48h observation
AUDIENCE_FILTER_ENABLED=false
# Voice mode — co-branded sender for dyad mode
EMAIL_FROM_SELVA=noreply@selva.town
# Worker concurrency
MAX_CONCURRENT_TASKS=3
WORKTREE_STALE_HOURS=24
# Redis XREAD block timeout (ms) for the worker's task-stream consumer.
# Tune lower for snappier shutdown, higher for fewer Redis round-trips
# when the stream is idle.
# REDIS_BLOCK_TIMEOUT_MS=5000
# Per-event emit timeout (seconds) for the synchronous fallback path
# in event_emitter._fire. Keep tight — events are fire-and-forget.
# EVENT_EMIT_TIMEOUT_SECONDS=3
# Persistence paths
BANDIT_PERSIST_PATH=/tmp/selva-bandit.json
MEMORY_PERSIST_DIR=/tmp/selva-memory
ARTIFACT_STORAGE_PATH=/tmp/selva-artifacts
# Autonomous gateway feature flags
AUTO_DISPATCH_ENABLED=false
# Billing routes through Dhanam (canonical Stripe/POS router). When true (default),
# /api/v1/stripe/webhook returns 503 — configure webhooks on Dhanam instead.
BILLING_VIA_DHANAM=true
FEATURE_STRIPE_MXN_LIVE=false
# Stripe webhook signing secret (whsec_...). Break-glass only when
# FEATURE_STRIPE_MXN_LIVE=true AND BILLING_VIA_DHANAM=false.
# → Webhooks → reveal signing secret. Empty default makes the
# /api/v1/stripe/webhook endpoint return 503 (fail-closed).
STRIPE_WEBHOOK_SECRET=
FEATURE_VOICE_MODE_LIVE=false
FEATURE_REDDIT_BOT=false
# Promotion gate
MIN_SOAK_MINUTES=30
# Git identity for agent commits
GIT_AUTHOR_NAME=selva-bot
GIT_AUTHOR_EMAIL=bot@selva.town

# ── Harness communication gateway relays ─────────────────────
# Native handlers use their provider-specific secrets above. These relays cover
# platforms that require a bridge process or where provider contracts are not
# stable enough to bind directly in Nexus API.
TEAMS_WEBHOOK_SECRET=
IRC_WEBHOOK_SECRET=
QQ_WEBHOOK_SECRET=
YUANBAO_WEBHOOK_SECRET=
