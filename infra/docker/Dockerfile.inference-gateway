# Selva inference gateway (RFC 0034 P2) — the extracted OpenAI-compatible /v1
# proxy. Mirrors Dockerfile.nexus-api; ships the inference-gateway app plus the
# shared packages and the nexus_api package it reuses (auth, database, models,
# the USD usage ledger) — one source of truth, its own process.
FROM python:3.12-slim AS builder

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY apps/inference-gateway/ apps/inference-gateway/
COPY apps/nexus-api/ apps/nexus-api/
COPY apps/workers/pyproject.toml apps/workers/
COPY packages/ packages/

# --package: sync the GATEWAY's dependency tree, not the workspace root's.
# A plain root sync installs only the root project's dependencies, which do
# not include selva-inference-gateway (nothing depends on it) — the venv then
# lacks the inference_gateway module and uvicorn dies on import.
RUN uv sync --frozen --no-dev --package selva-inference-gateway

FROM python:3.12-slim AS runtime

WORKDIR /app

RUN groupadd --gid 1001 appuser && \
    useradd --uid 1001 --gid appuser --shell /bin/sh --create-home appuser

LABEL org.opencontainers.image.source=https://github.com/madfam-org/selva-office

COPY --from=builder /app/.venv /app/.venv
COPY apps/inference-gateway/ apps/inference-gateway/
COPY apps/nexus-api/ apps/nexus-api/
COPY packages/ packages/

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

EXPOSE 4306

USER appuser

CMD ["uvicorn", "inference_gateway.main:app", "--host", "0.0.0.0", "--port", "4306"]
