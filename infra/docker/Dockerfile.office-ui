# syntax=docker/dockerfile:1.7

# Stage 1: Dependencies
FROM node:22-alpine AS deps

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/office-ui/package.json apps/office-ui/
COPY packages/ packages/

RUN pnpm install --frozen-lockfile

# Stage 2: Builder
FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/office-ui/node_modules ./apps/office-ui/node_modules
COPY --from=deps /app/packages/ ./packages/
COPY apps/office-ui/ apps/office-ui/
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json turbo.json ./

ENV NEXT_TELEMETRY_DISABLED=1

# Next.js bakes NEXT_PUBLIC_* at build time — these must be ARGs
ARG NEXT_PUBLIC_API_URL=https://api.selva.town
ARG NEXT_PUBLIC_COLYSEUS_URL=wss://ws.selva.town
ARG NEXT_PUBLIC_JANUA_ISSUER_URL=https://auth.madfam.io
ARG NEXT_PUBLIC_JANUA_CLIENT_ID=selva-office
ARG NEXT_PUBLIC_DEMO_ENABLED=true
ARG NEXT_PUBLIC_GUEST_ACCESS_ENABLED=true
ARG NEXT_PUBLIC_APP_URL=https://app.selva.town
ARG NEXT_PUBLIC_MARKETING_URL=https://selva.town
ARG NEXT_PUBLIC_SENTRY_DSN=
ARG NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
ARG NEXT_PUBLIC_SENTRY_RELEASE=
ARG NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
ARG SENTRY_ORG=
ARG SENTRY_PROJECT=selva-office-ui
ARG SENTRY_URL=https://sentry.io/
ARG SENTRY_RELEASE=

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_COLYSEUS_URL=$NEXT_PUBLIC_COLYSEUS_URL
ENV NEXT_PUBLIC_JANUA_ISSUER_URL=$NEXT_PUBLIC_JANUA_ISSUER_URL
ENV NEXT_PUBLIC_JANUA_CLIENT_ID=$NEXT_PUBLIC_JANUA_CLIENT_ID
ENV NEXT_PUBLIC_DEMO_ENABLED=$NEXT_PUBLIC_DEMO_ENABLED
ENV NEXT_PUBLIC_GUEST_ACCESS_ENABLED=$NEXT_PUBLIC_GUEST_ACCESS_ENABLED
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_MARKETING_URL=$NEXT_PUBLIC_MARKETING_URL
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_SENTRY_ENVIRONMENT=$NEXT_PUBLIC_SENTRY_ENVIRONMENT
ENV NEXT_PUBLIC_SENTRY_RELEASE=$NEXT_PUBLIC_SENTRY_RELEASE
ENV NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=$NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE
ENV SENTRY_ORG=$SENTRY_ORG
ENV SENTRY_PROJECT=$SENTRY_PROJECT
ENV SENTRY_URL=$SENTRY_URL
ENV SENTRY_RELEASE=$SENTRY_RELEASE

RUN --mount=type=secret,id=sentry_auth_token,required=false \
    export SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token 2>/dev/null || true)" && \
    pnpm --filter @selva/shared-types build && \
    pnpm --filter @selva/map-gen build && \
    pnpm --filter office-ui build

# Stage 3: Runner
FROM node:22-alpine AS runner

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
ARG NEXT_PUBLIC_SENTRY_RELEASE=
ARG NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
ARG SENTRY_RELEASE=

ENV NEXT_PUBLIC_SENTRY_ENVIRONMENT=$NEXT_PUBLIC_SENTRY_ENVIRONMENT
ENV NEXT_PUBLIC_SENTRY_RELEASE=$NEXT_PUBLIC_SENTRY_RELEASE
ENV NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=$NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE
ENV SENTRY_ENVIRONMENT=$NEXT_PUBLIC_SENTRY_ENVIRONMENT
ENV SENTRY_RELEASE=$SENTRY_RELEASE

LABEL org.opencontainers.image.source=https://github.com/madfam-org/selva-office

COPY --from=builder --chown=nextjs:nodejs /app/apps/office-ui/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/office-ui/.next/static ./apps/office-ui/.next/static
COPY --from=builder /app/apps/office-ui/public ./apps/office-ui/public

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

USER nextjs

CMD ["node", "apps/office-ui/server.js"]
