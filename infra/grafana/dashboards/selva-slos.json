      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "selva:task:success_rate_overall:7d{service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Task success rate 7d (SLOS.md §6; target ≥ 95%)",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "DLQ depth. SLOS.md §6 target: < 5 sustained. > 5 for 5 minutes triggers SelvaDLQDepthHigh page. Recording rule: selva:task:dlq_depth.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 3},
              {"color": "red", "value": 5}
            ]
          },
          "unit": "short"
