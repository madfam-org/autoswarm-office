      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "selva:request:error_rate:5m{tier=\"3\", service=~\"$service\"}",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ],
      "title": "Tier 3 — Error rate (SLOS.md §3; target ≤ 0.01)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27},
      "id": 103,
      "panels": [],
      "title": "30-day availability burn-down (SLOS.md §3)",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Per-tier worst-case 30-day rolling availability. Shows the most-degraded endpoint per tier. Below the threshold = SLO breach. Recording rule: selva:tier:availability_worst:30d.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "max": 1,
          "min": 0.95,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.99},
              {"color": "yellow", "value": 0.995},
              {"color": "green", "value": 0.999}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
      "id": 7,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "selva:tier:availability_worst:30d{service=~\"$service\"}",
          "legendFormat": "Tier {{tier}} — {{service}}",
          "refId": "A"
        }
      ],
      "title": "30-day availability worst-case per tier (SLOS.md §3 — Tier 1 ≥ 99.9%, Tier 2 ≥ 99.5%, Tier 3 ≥ 99.0%)",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 36},
      "id": 104,
      "panels": [],
      "title": "Task-level SLIs (SLOS.md §6)",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Overall task success rate over rolling 7 days. SLOS.md §6 target: ≥ 95%. Below 95% triggers SelvaTaskSuccessRateLow alert. Recording rule: selva:task:success_rate_overall:7d.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "max": 1,
          "min": 0.85,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.9},
              {"color": "green", "value": 0.95}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 37},
      "id": 8,
      "options": {
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showThresholdLabels": false,
