          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 0.005},
              {"color": "red", "value": 0.015}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "id": 4,
      "options": {
        "legend": {"calcs": ["max", "mean"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "selva:request:error_rate:5m{tier=\"2\", service=~\"$service\"}",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ],
      "title": "Tier 2 — Error rate (SLOS.md §3; target ≤ 0.005, alert ≥ 0.015)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "id": 102,
      "panels": [],
      "title": "Tier 3 — Background / cosmetic endpoints (SLOS.md §1, §3 99.0% availability, §4)",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Tier 3 latency p50 / p95 / p99. Tier 3 has no burn-rate alerts (SLOS.md §5); these panels exist for awareness. Target lines: p99 < 10000ms (SLOS.md §2).",
      "fieldConfig": {
