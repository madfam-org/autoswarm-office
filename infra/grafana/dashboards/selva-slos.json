      "title": "Tier 3 — Latency p50 / p95 / p99 (SLOS.md §2; target p99 < 10000ms)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Tier 3 error rate. No burn-rate alerts on Tier 3 per SLOS.md §5; site-down detection via blackbox-exporter.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "error rate",
            "drawStyle": "line",
            "fillOpacity": 15,
