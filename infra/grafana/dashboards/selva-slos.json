      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 19},
      "id": 6,
      "options": {
        "legend": {"calcs": ["max", "mean"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
