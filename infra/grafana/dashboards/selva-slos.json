      ],
      "title": "Tier 2 — Latency p50 / p95 / p99 (SLOS.md §2; target p99 < 3000ms)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Tier 2 error rate. SLOS.md §3 budget = 0.5% (99.5% target). Threshold lines mark Tier 2 burn-rate alerts: fast notify 1.5%, slow notify 0.5%.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "error rate",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "lineWidth": 2
