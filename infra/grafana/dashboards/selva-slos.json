{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource for Selva SLO panels",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Selva Office SLO dashboard. Visualizes the SLIs defined in docs/SLOS.md per service tier. Panels cite the SLO section they back. Becomes useful once OTel exporter is wired (Phase 2 item 11) and recording rules in infra/prometheus/recording-rules.yml are loaded.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "icon": "doc",
      "tags": [],
      "title": "SLO definitions (SLOS.md)",
      "tooltip": "Per-tier latency / error / availability targets",
      "type": "link",
      "url": "https://github.com/madfam-org/selva-office/blob/main/docs/SLOS.md"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "panels": [],
      "title": "Tier 1 — User-blocking endpoints (SLOS.md §1, §3 99.9% availability, §4)",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Tier 1 latency p50 / p95 / p99 over 5-minute windows. Target lines: p99 < 1500ms (SLOS.md §2). Recording rules: selva:request:latency_p{50,95,99}:5m.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "ms",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 500},
              {"color": "red", "value": 1500}
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "legend": {"calcs": ["max", "mean"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "selva:request:latency_p99:5m{tier=\"1\", service=~\"$service\"}",
          "legendFormat": "p99 — {{http_route}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "selva:request:latency_p95:5m{tier=\"1\", service=~\"$service\"}",
          "legendFormat": "p95 — {{http_route}}",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "selva:request:latency_p50:5m{tier=\"1\", service=~\"$service\"}",
          "legendFormat": "p50 — {{http_route}}",
          "refId": "C"
        }
      ],
      "title": "Tier 1 — Latency p50 / p95 / p99 (SLOS.md §2; target p99 < 1500ms)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Tier 1 error rate over 5-minute windows. SLOS.md §3 budget = 0.1% (99.9% target). The threshold lines mark the burn-rate alert thresholds (1.44% = fast burn, 0.6% = slow burn). Recording rule: selva:request:error_rate:5m.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "error rate",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 0.006},
              {"color": "red", "value": 0.0144}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "id": 2,
      "options": {
        "legend": {"calcs": ["max", "mean"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "selva:request:error_rate:5m{tier=\"1\", service=~\"$service\"}",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ],
      "title": "Tier 1 — Error rate (SLOS.md §3; target ≤ 0.001, alert ≥ 0.0144)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "id": 101,
      "panels": [],
      "title": "Tier 2 — Feature-degrading endpoints (SLOS.md §1, §3 99.5% availability, §4)",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Tier 2 latency p50 / p95 / p99 over 5-minute windows. Target lines: p99 < 3000ms (SLOS.md §2).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "ms",
            "drawStyle": "line",
            "fillOpacity": 10,
