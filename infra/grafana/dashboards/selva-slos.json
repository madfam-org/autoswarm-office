  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["slo", "selva", "observability"],
  "templating": {
    "list": [
      {
        "current": {"selected": false, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "definition": "label_values(http_server_requests_total, service)",
        "description": "Filter all panels by service. Defaults to All so the dashboard works the moment a single OTel exporter starts emitting.",
        "hide": 0,
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(http_server_requests_total, service)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-24h", "to": "now"},
