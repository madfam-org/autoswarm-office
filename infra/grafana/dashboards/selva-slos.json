          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "id": 3,
      "options": {
        "legend": {"calcs": ["max", "mean"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "selva:request:latency_p99:5m{tier=\"2\", service=~\"$service\"}",
          "legendFormat": "p99 — {{http_route}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "selva:request:latency_p95:5m{tier=\"2\", service=~\"$service\"}",
          "legendFormat": "p95 — {{http_route}}",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "selva:request:latency_p50:5m{tier=\"2\", service=~\"$service\"}",
          "legendFormat": "p50 — {{http_route}}",
          "refId": "C"
